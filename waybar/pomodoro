#!/usr/bin/env python3
"""Waybar module front-end for the Pomodoro daemon.

status  -> prints {"text": ..., "class": [...]} for the bar
toggle/open/close/start/pause/reset/skip  -> talks to the daemon socket
"""

import json
import os
import socket
import subprocess
import sys
import time

XDG = os.environ.get("XDG_RUNTIME_DIR", "/tmp")
SOCK = os.path.join(XDG, "pomodoro.sock")
STATE = os.path.join(XDG, "pomodoro", "state.json")
APP = "/home/hawkaii/.config/pomodoro-mc/app.py"
PENGUIN = "\U000f033d"        # U+F033D, the same glyph as custom/distro


def running():
    if not os.path.exists(SOCK):
        return False
    try:
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        s.settimeout(0.3)
        s.connect(SOCK)
        s.close()
        return True
    except OSError:
        return False


def ensure():
    if running():
        return
    try:
        with open(os.path.join(XDG, "pomodoro.pid")) as f:
            pid = int(f.read().strip())
        os.kill(pid, 0)
    except Exception:
        subprocess.Popen(["python3", APP],
                         stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, start_new_session=True)
    for _ in range(60):
        if running():
            return
        time.sleep(0.05)


def fmt(seconds):
    s = max(0, int(seconds + 0.5))
    if s >= 3600:
        return f"{s // 3600}:{s % 3600 // 60:02d}:{s % 60:02d}"
    return f"{s // 60:02d}:{s % 60:02d}"


def status():
    try:
        with open(STATE) as f:
            d = json.load(f)
    except Exception:
        return {"text": PENGUIN, "class": ["pomodoro-idle"]}
    phase, going = d.get("phase", "idle"), d.get("running", False)
    # Only a running timer drains. A paused timer keeps its frozen value.
    rem = d.get("remaining_s", 0)
    if going:
        rem = max(0.0, rem - (time.time() - d.get("updated_at", 0)))
    if phase == "idle" and not going:
        return {"text": PENGUIN, "class": ["pomodoro-idle"]}
    if not going:
        return {"text": fmt(rem), "class": ["pomodoro-paused"]}
    cls = {"focus": "pomodoro-focus", "break": "pomodoro-break",
           "longbreak": "pomodoro-break"}.get(phase, "pomodoro-focus")
    return {"text": fmt(rem), "class": [cls]}


def main():
    cmd = sys.argv[1] if len(sys.argv) > 1 else "status"
    if cmd in ("toggle", "open", "close", "start", "pause", "reset", "skip", "resume"):
        ensure()
        try:
            s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
            s.settimeout(1)
            s.connect(SOCK)
            s.sendall((cmd + "\n").encode())
            s.close()
        except OSError:
            pass
    print(json.dumps(status()))


main()
